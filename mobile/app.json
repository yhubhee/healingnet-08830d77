{
  "expo": {
    "name": "HealingNet",
    "slug": "healingnet",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "healingnet",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.healingnet.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.healingnet.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#186E6A",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock HealingNet."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HealingNet uses your photos only to set your profile picture and to send a document that proves a family relationship.",
          "cameraPermission": "HealingNet uses the camera to scan a hospital's check-in code, for video visits with your doctor, to take your profile picture, and to photograph a document that proves a family relationship.",
          "microphonePermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "HealingNet adds your appointments to your calendar when you ask it to."
        }
      ],
      "./plugins/withCalendarQueries",
      [
        "expo-camera",
        {
          "cameraPermission": "HealingNet uses the camera to scan a hospital's check-in code and for video visits with your doctor.",
          "microphonePermission": "HealingNet uses the microphone so your doctor can hear you during a video visit.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HealingNet uses your location to show how far each hospital is."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "root": "app"
      },
      "eas": {
        "projectId": "7e8c4716-3121-421a-88d7-c0456dbe3c8f"
      }
    },
    "owner": "healingnet"
  }
}
