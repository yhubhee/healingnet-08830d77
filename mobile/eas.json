{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "HN_ANDROID_ARCHS": "arm64-v8a,armeabi-v7a",
        "HN_COMPRESS_NATIVE_LIBS": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "HN_ANDROID_ARCHS": "arm64-v8a,armeabi-v7a",
        "HN_COMPRESS_NATIVE_LIBS": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "HN_ANDROID_ARCHS": "arm64-v8a,armeabi-v7a"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
