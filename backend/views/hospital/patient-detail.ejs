<!-- Patient Detail EJS Template -->
<div class="welcome-section">
  <div class="welcome-text">
    <h1><%= patient.firstname %> <%= patient.lastname %></h1>
    <p>Patient ID: <%= patient.patient_id %> · <%= patient.gender || '' %> · DOB: <%= patient.date_of_birth ? new Date(patient.date_of_birth).toLocaleDateString('en-NG') : '--' %></p>
  </div>
  <div class="welcome-actions">
    <button class="btn btn-outline" onclick="document.querySelector('[data-url=\'/hospital/patients\']')?.click()">
      <i data-lucide="arrow-left"></i> Back to List
    </button>
  </div>
</div>

<!-- Patient Info Cards -->
<div class="stats-grid">
  <div class="stat-card gradient-primary">
    <i data-lucide="droplet" class="stat-icon"></i>
    <div class="stat-content">
      <p class="stat-label">Blood Type</p>
      <h3 class="stat-value"><%= patient.blood_type || '--' %></h3>
    </div>
  </div>
  <div class="stat-card gradient-info">
    <i data-lucide="dna" class="stat-icon"></i>
    <div class="stat-content">
      <p class="stat-label">Genotype</p>
      <h3 class="stat-value"><%= patient.genotype || '--' %></h3>
    </div>
  </div>
  <div class="stat-card gradient-warning">
    <i data-lucide="shield-check" class="stat-icon"></i>
    <div class="stat-content">
      <p class="stat-label">Insurance</p>
      <h3 class="stat-value"><%= patient.insurance_provider || 'None' %></h3>
    </div>
  </div>
  <div class="stat-card gradient-success">
    <i data-lucide="phone" class="stat-icon"></i>
    <div class="stat-content">
      <p class="stat-label">Phone</p>
      <h3 class="stat-value"><%= patient.phone || '--' %></h3>
    </div>
  </div>
</div>

<!-- Tabs -->
<div class="tab-nav" style="margin:1.5rem 0 1rem;">
  <button class="tab-btn active" onclick="showPatientTab('emr', this)">EMR (<%= emr_entries.length %>)</button>
  <button class="tab-btn" onclick="showPatientTab('appointments', this)">Appointments (<%= appointments.length %>)</button>
  <button class="tab-btn" onclick="showPatientTab('prescriptions', this)">Prescriptions (<%= prescriptions.length %>)</button>
  <button class="tab-btn" onclick="showPatientTab('billing', this)">Billing (<%= billing.length %>)</button>
</div>

<!-- EMR Tab -->
<div class="card tab-panel" id="emr-panel">
  <div class="card-header"><h2>EMR Entries</h2></div>
  <div class="table-responsive">
    <table class="data-table">
      <thead><tr><th>Type</th><th>Title</th><th>Doctor</th><th>Date</th></tr></thead>
      <tbody>
        <% if (emr_entries.length > 0) { %>
          <% emr_entries.forEach(function(e) { %>
            <tr>
              <td><span class="badge"><%= (e.entry_type || '').replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) %></span></td>
              <td><%= e.title %></td>
              <td>Dr. <%= e.doctor_name || '--' %></td>
              <td><%= e.created_at ? new Date(e.created_at).toLocaleDateString('en-NG') : '--' %></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr><td colspan="4" style="text-align:center;padding:2rem;color:var(--muted-foreground);">No EMR entries</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Appointments Tab -->
<div class="card tab-panel" id="appointments-panel" style="display:none;">
  <div class="card-header"><h2>Appointments</h2></div>
  <div class="table-responsive">
    <table class="data-table">
      <thead><tr><th>Doctor</th><th>Specialty</th><th>Date</th><th>Status</th></tr></thead>
      <tbody>
        <% if (appointments.length > 0) { %>
          <% appointments.forEach(function(a) { %>
            <tr>
              <td>Dr. <%= a.doctor_name %></td>
              <td><%= a.specialty || '--' %></td>
              <td><%= a.appointment_date ? new Date(a.appointment_date).toLocaleDateString('en-NG') : '--' %></td>
              <td><span class="status-badge <%= a.status %>"><%= (a.status || '').replace(/\b\w/g, c => c.toUpperCase()) %></span></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr><td colspan="4" style="text-align:center;padding:2rem;color:var(--muted-foreground);">No appointments</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Prescriptions Tab -->
<div class="card tab-panel" id="prescriptions-panel" style="display:none;">
  <div class="card-header"><h2>Prescriptions</h2></div>
  <div class="table-responsive">
    <table class="data-table">
      <thead><tr><th>Doctor</th><th>Medication</th><th>Date</th></tr></thead>
      <tbody>
        <% if (prescriptions.length > 0) { %>
          <% prescriptions.forEach(function(p) { %>
            <tr>
              <td>Dr. <%= p.doctor_name %></td>
              <td><%= p.medication || p.drug_name || '--' %></td>
              <td><%= p.created_at ? new Date(p.created_at).toLocaleDateString('en-NG') : '--' %></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr><td colspan="3" style="text-align:center;padding:2rem;color:var(--muted-foreground);">No prescriptions</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Billing Tab -->
<div class="card tab-panel" id="billing-panel" style="display:none;">
  <div class="card-header"><h2>Billing History</h2></div>
  <div class="table-responsive">
    <table class="data-table">
      <thead><tr><th>Description</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead>
      <tbody>
        <% if (billing.length > 0) { %>
          <% billing.forEach(function(b) { %>
            <tr>
              <td><%= b.description || b.billing_type || '--' %></td>
              <td>₦<%= Number(b.total || 0).toLocaleString() %></td>
              <td><span class="status-badge <%= b.payment_status %>"><%= (b.payment_status || '').replace(/\b\w/g, c => c.toUpperCase()) %></span></td>
              <td><%= b.created_at ? new Date(b.created_at).toLocaleDateString('en-NG') : '--' %></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr><td colspan="4" style="text-align:center;padding:2rem;color:var(--muted-foreground);">No billing records</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
function showPatientTab(tab, btn) {
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.tab-panel').forEach(p => p.style.display = 'none');
  document.getElementById(tab + '-panel').style.display = '';
}
</script>