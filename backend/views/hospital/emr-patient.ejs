<%
    const p = patient;
    const fn = p.firstname || p.first_name || '';
    const ln = p.lastname || p.last_name || '';
    const age = p.date_of_birth ? Math.floor((Date.now() - new Date(p.date_of_birth).getTime()) / 31557600000) : '?';
    const initials = (fn[0] || '') + (ln[0] || '');
    const dob = p.date_of_birth ? new Date(p.date_of_birth).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) : '—';

    const typeColors = {
        consultation_note: { bg: 'hsl(210,80%,55%,0.15)', color: 'hsl(210,80%,65%)' },
        vitals: { bg: 'hsl(160,84%,39%,0.15)', color: 'var(--success)' },
        diagnosis: { bg: 'hsl(0,84%,60%,0.15)', color: 'var(--destructive)' },
        procedure: { bg: 'hsl(280,60%,55%,0.15)', color: 'hsl(280,60%,65%)' },
        lab_order: { bg: 'hsl(38,92%,50%,0.15)', color: 'var(--warning)' },
        lab_result: { bg: 'hsl(38,92%,50%,0.15)', color: 'var(--warning)' },
        imaging: { bg: 'hsl(270,60%,50%,0.15)', color: 'hsl(270,60%,65%)' },
        referral: { bg: 'hsl(190,70%,50%,0.15)', color: 'hsl(190,70%,60%)' },
        discharge_summary: { bg: 'hsl(140,50%,45%,0.15)', color: 'hsl(140,50%,60%)' },
        surgery_note: { bg: 'hsl(350,70%,55%,0.15)', color: 'hsl(350,70%,65%)' },
        antenatal: { bg: 'hsl(320,60%,55%,0.15)', color: 'hsl(320,60%,65%)' },
        delivery: { bg: 'hsl(330,70%,55%,0.15)', color: 'hsl(330,70%,65%)' },
        postnatal: { bg: 'hsl(300,50%,55%,0.15)', color: 'hsl(300,50%,65%)' },
    };

    function typeLabel(t) { return (t||'').replace(/_/g,' ').replace(/\b\w/g, function(c){ return c.toUpperCase(); }); }
%>

<!-- Selected Patient Header -->
<div class="emr-patient-header" style="display:flex;align-items:center;gap:1rem;padding:1rem;background:var(--card);border-radius:var(--radius);margin-bottom:1rem;border:1px solid var(--border);">
    <div class="avatar" style="width:64px;height:64px;font-size:1.5rem;"><%= initials %></div>
    <div style="flex:1;">
        <h2 style="margin:0;font-size:1.2rem;"><%= fn %> <%= ln %></h2>
        <div class="patient-meta" style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.25rem;font-size:0.85rem;color:var(--muted-foreground);">
            <span><i data-lucide="user" style="width:14px;height:14px;display:inline;"></i> <%= p.gender || '?' %>, <%= age %> yrs</span>
            <span><i data-lucide="droplet" style="width:14px;height:14px;display:inline;"></i> <%= p.blood_type || p.blood_group || '?' %> &bull; <%= p.genotype || '?' %></span>
            <span><i data-lucide="phone" style="width:14px;height:14px;display:inline;"></i> <%= p.phone || '—' %></span>
            <% if (p.allergies) { %>
                <span><i data-lucide="alert-triangle" style="width:14px;height:14px;display:inline;color:var(--warning);"></i> Allergies: <%= p.allergies %></span>
            <% } %>
        </div>
    </div>
    <div style="display:flex;gap:0.5rem;">
        <button class="btn btn-outline btn-sm" onclick="toggleFullProfile()"><i data-lucide="user"></i> Full Profile</button>
        <button class="btn btn-primary btn-sm" onclick="openNewEntry()"><i data-lucide="plus"></i> New Entry</button>
    </div>
</div>

<!-- ===================== FULL PROFILE PANEL ===================== -->
<div id="emrFullProfile" style="display:none;margin-bottom:1.5rem;">
    <div class="card" style="padding:1.5rem;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
            <h2 style="font-size:1.1rem;">Full Patient Profile</h2>
            <button class="btn btn-outline btn-sm" onclick="toggleFullProfile()">Close</button>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;">
            <!-- Personal Information -->
            <div class="content-section">
                <div class="section-header"><h3 style="font-size:0.95rem;">Personal Information</h3></div>
                <div class="detail-grid">
                    <div class="detail-row"><span class="detail-label">Full Name</span><span><%= fn %> <%= ln %></span></div>
                    <div class="detail-row"><span class="detail-label">Date of Birth</span><span><%= dob %></span></div>
                    <div class="detail-row"><span class="detail-label">Gender</span><span><%= p.gender || '—' %></span></div>
                    <div class="detail-row"><span class="detail-label">Phone</span><span><%= p.phone || '—' %></span></div>
                    <div class="detail-row"><span class="detail-label">Email</span><span><%= p.email || '—' %></span></div>
                    <div class="detail-row"><span class="detail-label">Address</span><span><%= p.address || '—' %></span></div>
                    <div class="detail-row"><span class="detail-label">National ID</span><span><%= p.national_id || '—' %></span></div>
                    <div class="detail-row"><span class="detail-label">Marital Status</span><span><%= p.marital_status || '—' %></span></div>
                    <div class="detail-row"><span class="detail-label">Occupation</span><span><%= p.occupation || '—' %></span></div>
                </div>
            </div>

            <!-- Medical Details -->
            <div class="content-section">
                <div class="section-header"><h3 style="font-size:0.95rem;">Medical Details</h3></div>
                <div class="detail-grid">
                    <div class="detail-row"><span class="detail-label">Blood Type</span><span><%= p.blood_type || p.blood_group || '—' %></span></div>
                    <div class="detail-row"><span class="detail-label">Genotype</span><span><%= p.genotype || '—' %></span></div>
                    <div class="detail-row"><span class="detail-label">Allergies</span><span><%= p.allergies || 'None' %></span></div>
                    <div class="detail-row"><span class="detail-label">Chronic Conditions</span><span><%= p.chronic_conditions || 'None' %></span></div>
                    <div class="detail-row"><span class="detail-label">Current Medications</span><span><%= p.medications || p.current_medications || 'None' %></span></div>
                    <div class="detail-row"><span class="detail-label">Surgical History</span><span><%= p.surgical_history || 'None' %></span></div>
                    <div class="detail-row"><span class="detail-label">Family History</span><span><%= p.family_medical_history || 'None' %></span></div>
                    <div class="detail-row"><span class="detail-label">Medical Conditions</span><span><%= p.medical_conditions || 'None' %></span></div>
                    <div class="detail-row"><span class="detail-label">Disabilities</span><span><%= p.disabilities || 'None' %></span></div>
                    <div class="detail-row"><span class="detail-label">Smoking</span><span><%= p.smoking_status || '—' %></span></div>
                    <div class="detail-row"><span class="detail-label">Alcohol</span><span><%= p.alcohol_consumption || '—' %></span></div>
                    <div class="detail-row"><span class="detail-label">Lifestyle</span><span><%= p.lifestyle_factors || '—' %></span></div>
                    <div class="detail-row"><span class="detail-label">Immunization</span><span><%= p.immunization_history || '—' %></span></div>
                </div>
            </div>

            <!-- Emergency Contact -->
            <div class="content-section">
                <div class="section-header"><h3 style="font-size:0.95rem;">Emergency Contact</h3></div>
                <div class="detail-grid">
                    <div class="detail-row"><span class="detail-label">Name</span><span><%= p.emergency_contact_name || '—' %></span></div>
                    <div class="detail-row"><span class="detail-label">Phone</span><span><%= p.emergency_contact_phone || '—' %></span></div>
                    <div class="detail-row"><span class="detail-label">Relationship</span><span><%= p.emergency_contact_relationship || '—' %></span></div>
                </div>
            </div>

            <!-- Insurance -->
            <div class="content-section">
                <div class="section-header"><h3 style="font-size:0.95rem;">Insurance</h3></div>
                <div class="detail-grid">
                    <div class="detail-row"><span class="detail-label">Provider</span><span><%= p.insurance_provider || 'None' %></span></div>
                    <div class="detail-row"><span class="detail-label">Policy #</span><span><%= p.insurance_number || '—' %></span></div>
                    <div class="detail-row"><span class="detail-label">HMO</span><span><%= p.hmo_provider || '—' %></span></div>
                    <div class="detail-row"><span class="detail-label">HMO ID</span><span><%= p.hmo_id || '—' %></span></div>
                </div>
            </div>
        </div>

        <!-- Prescriptions -->
        <% if (prescriptions && prescriptions.length) { %>
            <div class="content-section" style="margin-top:1.5rem;">
                <div class="section-header"><h3 style="font-size:0.95rem;">Recent Prescriptions</h3></div>
                <table class="data-table" style="width:100%;font-size:0.85rem;">
                    <thead><tr><th>Drug</th><th>Dosage</th><th>Frequency</th><th>Duration</th><th>Doctor</th><th>Date</th></tr></thead>
                    <tbody>
                        <% prescriptions.forEach(function(rx) { %>
                            <tr>
                                <td><%= rx.drug_name %></td>
                                <td><%= rx.dosage %></td>
                                <td><%= rx.frequency %></td>
                                <td><%= rx.duration %></td>
                                <td>Dr. <%= rx.doctor_first_name %> <%= rx.doctor_last_name || '' %></td>
                                <td><%= new Date(rx.created_at).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>

        <!-- Recent Appointments -->
        <% if (appointments && appointments.length) { %>
            <div class="content-section" style="margin-top:1.5rem;">
                <div class="section-header"><h3 style="font-size:0.95rem;">Recent Appointments</h3></div>
                <table class="data-table" style="width:100%;font-size:0.85rem;">
                    <thead><tr><th>Date</th><th>Doctor</th><th>Specialty</th><th>Type</th><th>Status</th></tr></thead>
                    <tbody>
                        <% appointments.forEach(function(apt) { %>
                            <tr>
                                <td><%= new Date(apt.appointment_date).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %></td>
                                <td>Dr. <%= apt.doctor_first_name %> <%= apt.doctor_last_name || '' %></td>
                                <td><%= apt.specialty || '—' %></td>
                                <td><%= apt.appointment_type || '—' %></td>
                                <td><span class="status-badge status-<%= apt.status %>"><%= apt.status %></span></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<!-- EMR Tabs -->
<div class="emr-tabs" style="display:flex;gap:0.25rem;flex-wrap:wrap;margin-bottom:1rem;">
    <button class="emr-tab active" onclick="filterEmrTab('all', this)">All Records</button>
    <button class="emr-tab" onclick="filterEmrTab('consultation_note', this)">Consultation Notes</button>
    <button class="emr-tab" onclick="filterEmrTab('vitals', this)">Vitals</button>
    <button class="emr-tab" onclick="filterEmrTab('diagnosis', this)">Diagnoses</button>
    <button class="emr-tab" onclick="filterEmrTab('procedure', this)">Procedures</button>
    <button class="emr-tab" onclick="filterEmrTab('lab_order', this)">Lab Orders</button>
    <button class="emr-tab" onclick="filterEmrTab('lab_result', this)">Lab Results</button>
    <button class="emr-tab" onclick="filterEmrTab('imaging', this)">Imaging</button>
    <button class="emr-tab" onclick="filterEmrTab('referral', this)">Referrals</button>
    <button class="emr-tab" onclick="filterEmrTab('discharge_summary', this)">Discharge</button>
    <button class="emr-tab" onclick="filterEmrTab('surgery_note', this)">Surgery</button>
    <button class="emr-tab" onclick="filterEmrTab('antenatal', this)">Antenatal</button>
    <button class="emr-tab" onclick="filterEmrTab('delivery', this)">Delivery</button>
    <button class="emr-tab" onclick="filterEmrTab('postnatal', this)">Postnatal</button>
</div>

<!-- EMR Entries Timeline -->
<div class="emr-entries">
    <% if (!emr_entries || !emr_entries.length) { %>
        <p style="padding:2rem;text-align:center;color:var(--muted-foreground);">No EMR entries found for this patient</p>
    <% } else { %>
        <% emr_entries.forEach(function(e) { %>
            <%
                const tc = typeColors[e.entry_type] || { bg: 'hsl(0,0%,50%,0.15)', color: 'var(--muted-foreground)' };
                const docName = e.doctor_first_name ? 'Dr. ' + e.doctor_first_name + ' ' + (e.doctor_last_name || '') : 'Staff';
                const entryDate = new Date(e.created_at).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' });
                let sd = null;
                try { sd = e.structured_data ? (typeof e.structured_data === 'string' ? JSON.parse(e.structured_data) : e.structured_data) : null; } catch(x) {}
            %>
            <div class="emr-entry" data-type="<%= e.entry_type %>">
                <div class="emr-entry-header">
                    <div>
                        <span class="emr-entry-type" style="background:<%= tc.bg %>;color:<%= tc.color %>;"><%= typeLabel(e.entry_type) %></span>
                        <h4><%= e.title %></h4>
                    </div>
                    <span class="entry-date"><%= entryDate %> &bull; <%= docName %><%= e.is_confidential ? ' 🔒' : '' %></span>
                </div>

                <% if (e.entry_type === 'vitals' && sd) { %>
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:0.75rem;margin-top:0.5rem;">
                        <% Object.entries(sd).forEach(function([k,v]) { %>
                            <div style="background:var(--background);padding:0.75rem;border-radius:var(--radius);">
                                <small style="color:var(--muted-foreground);"><%= typeLabel(k) %></small>
                                <p style="font-weight:700;"><%= v %></p>
                            </div>
                        <% }); %>
                    </div>

                <% } else if (e.entry_type === 'consultation_note' && sd) { %>
                    <% if (sd.chief_complaint) { %><p><strong>Chief Complaint:</strong> <%= sd.chief_complaint %></p><% } %>
                    <% if (sd.hpi) { %><p><strong>HPI:</strong> <%= sd.hpi %></p><% } %>
                    <% if (sd.examination) { %><p><strong>Examination:</strong> <%= sd.examination %></p><% } %>
                    <% if (sd.assessment) { %><p><strong>Assessment & Plan:</strong> <%= sd.assessment %></p><% } %>
                    <% if (sd.follow_up) { %><p style="font-size:0.85rem;"><strong>Follow-up:</strong> <%= sd.follow_up %></p><% } %>
                    <% if (sd.prescriptions) { %><p style="font-size:0.85rem;"><strong>Prescriptions:</strong> <%= sd.prescriptions %></p><% } %>
                    <% if (e.content) { %><p><%= e.content %></p><% } %>

                <% } else if (e.entry_type === 'diagnosis' && sd) { %>
                    <% if (e.content || sd.description) { %><p><%= e.content || sd.description %></p><% } %>
                    <div style="margin-top:0.5rem;display:flex;gap:1rem;flex-wrap:wrap;font-size:0.85rem;">
                        <% if (sd.icd_code) { %><span><strong>ICD-10:</strong> <%= sd.icd_code %></span><% } %>
                        <% if (sd.severity) { %><span><strong>Severity:</strong> <%= sd.severity %></span><% } %>
                        <% if (sd.type) { %><span><strong>Type:</strong> <%= sd.type %></span><% } %>
                        <% if (sd.status) { %><span><strong>Status:</strong> <%= sd.status %></span><% } %>
                    </div>

                <% } else if (e.entry_type === 'procedure' && sd) { %>
                    <% if (e.content) { %><p><%= e.content %></p><% } %>
                    <div style="margin-top:0.5rem;display:flex;gap:1rem;flex-wrap:wrap;font-size:0.85rem;">
                        <% if (sd.procedure_name) { %><span><strong>Procedure:</strong> <%= sd.procedure_name %></span><% } %>
                        <% if (sd.anaesthesia) { %><span><strong>Anaesthesia:</strong> <%= sd.anaesthesia %></span><% } %>
                        <% if (sd.duration) { %><span><strong>Duration:</strong> <%= sd.duration %> min</span><% } %>
                        <% if (sd.outcome) { %><span><strong>Outcome:</strong> <%= sd.outcome %></span><% } %>
                    </div>
                    <% if (sd.findings) { %><p style="font-size:0.85rem;margin-top:0.25rem;"><strong>Findings:</strong> <%= sd.findings %></p><% } %>
                    <% if (sd.complications) { %><p style="font-size:0.85rem;color:var(--destructive);"><strong>Complications:</strong> <%= sd.complications %></p><% } %>
                    <% if (sd.post_instructions) { %><p style="font-size:0.85rem;"><strong>Post-procedure:</strong> <%= sd.post_instructions %></p><% } %>

                <% } else if (e.entry_type === 'lab_order' && sd) { %>
                    <% if (e.content) { %><p><%= e.content %></p><% } %>
                    <div style="margin-top:0.5rem;font-size:0.85rem;">
                        <% if (sd.tests) { %><strong>Tests ordered:</strong> <%= Array.isArray(sd.tests) ? sd.tests.join(', ') : sd.tests %><% } %>
                        <% if (sd.urgency) { %> &bull; <strong>Urgency:</strong> <%= sd.urgency %><% } %>
                        <% if (sd.fasting) { %> &bull; <strong>Fasting:</strong> <%= sd.fasting %><% } %>
                        <% if (sd.specimen) { %> &bull; <strong>Specimen:</strong> <%= sd.specimen %><% } %>
                        <% if (sd.indication) { %><br><strong>Indication:</strong> <%= sd.indication %><% } %>
                    </div>

                <% } else if (e.entry_type === 'lab_result' && sd) { %>
                    <% if (sd.category) { %><p style="font-size:0.85rem;"><strong>Category:</strong> <%= sd.category %> <% if (sd.specimen) { %>&bull; <strong>Specimen:</strong> <%= sd.specimen %><% } %></p><% } %>
                    <% if (sd.results && sd.results.length) { %>
                        <table style="width:100%;font-size:0.85rem;margin-top:0.5rem;border-collapse:collapse;">
                            <thead><tr style="border-bottom:1px solid var(--border);"><th style="text-align:left;padding:0.25rem 0.5rem;">Test</th><th style="text-align:left;padding:0.25rem 0.5rem;">Value</th><th style="text-align:left;padding:0.25rem 0.5rem;">Unit</th><th style="text-align:left;padding:0.25rem 0.5rem;">Flag</th></tr></thead>
                            <tbody>
                                <% sd.results.forEach(function(r) { %>
                                    <tr style="border-bottom:1px solid var(--border);">
                                        <td style="padding:0.25rem 0.5rem;"><%= r.test %></td>
                                        <td style="padding:0.25rem 0.5rem;font-weight:600;"><%= r.value %></td>
                                        <td style="padding:0.25rem 0.5rem;"><%= r.unit || '' %></td>
                                        <td style="padding:0.25rem 0.5rem;color:<%= r.flag === 'normal' ? 'var(--success)' : 'var(--destructive)' %>;"><%= r.flag || '' %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } %>
                    <% if (sd.interpretation) { %><p style="font-size:0.85rem;margin-top:0.5rem;"><strong>Interpretation:</strong> <%= sd.interpretation %></p><% } %>

                <% } else if (e.entry_type === 'imaging' && sd) { %>
                    <% if (e.content) { %><p><%= e.content %></p><% } %>
                    <div style="margin-top:0.5rem;font-size:0.85rem;">
                        <% if (sd.modality) { %><strong>Modality:</strong> <%= sd.modality %><% } %>
                        <% if (sd.body_part) { %> &bull; <strong>Body part:</strong> <%= sd.body_part %><% } %>
                        <% if (sd.contrast) { %> &bull; <strong>Contrast:</strong> <%= sd.contrast %><% } %>
                        <% if (sd.findings) { %><br><strong>Findings:</strong> <%= sd.findings %><% } %>
                        <% if (sd.impression) { %><br><strong>Impression:</strong> <%= sd.impression %><% } %>
                        <% if (sd.recommendation) { %><br><strong>Recommendation:</strong> <%= sd.recommendation %><% } %>
                    </div>

                <% } else if (e.entry_type === 'referral' && sd) { %>
                    <% if (e.content) { %><p><%= e.content %></p><% } %>
                    <div style="margin-top:0.5rem;font-size:0.85rem;">
                        <% if (sd.referred_to) { %><strong>Referred to:</strong> <%= sd.referred_to %><% } %>
                        <% if (sd.specialty) { %> &bull; <strong>Specialty:</strong> <%= sd.specialty %><% } %>
                        <% if (sd.urgency) { %> &bull; <strong>Urgency:</strong> <%= sd.urgency %><% } %>
                        <% if (sd.referral_type) { %> &bull; <strong>Type:</strong> <%= sd.referral_type %><% } %>
                        <% if (sd.reason) { %><br><strong>Reason:</strong> <%= sd.reason %><% } %>
                        <% if (sd.clinical_summary) { %><br><strong>Clinical Summary:</strong> <%= sd.clinical_summary %><% } %>
                    </div>

                <% } else if (e.entry_type === 'discharge_summary' && sd) { %>
                    <% if (e.content) { %><p><%= e.content %></p><% } %>
                    <div style="margin-top:0.5rem;font-size:0.85rem;">
                        <% if (sd.admission_date) { %><strong>Admitted:</strong> <%= sd.admission_date %><% } %>
                        <% if (sd.discharge_date) { %> &rarr; <strong>Discharged:</strong> <%= sd.discharge_date %><% } %>
                        <% if (sd.condition) { %> &bull; <strong>Condition:</strong> <%= sd.condition %><% } %>
                        <% if (sd.admitting_diagnosis) { %><br><strong>Admitting Dx:</strong> <%= sd.admitting_diagnosis %><% } %>
                        <% if (sd.discharge_diagnosis) { %><br><strong>Discharge Dx:</strong> <%= sd.discharge_diagnosis %><% } %>
                        <% if (sd.summary) { %><br><strong>Summary:</strong> <%= sd.summary %><% } %>
                        <% if (sd.discharge_medications) { %><br><strong>Medications:</strong> <%= sd.discharge_medications %><% } %>
                        <% if (sd.follow_up) { %><br><strong>Follow-up:</strong> <%= sd.follow_up %><% } %>
                    </div>

                <% } else if (e.entry_type === 'surgery_note' && sd) { %>
                    <% if (e.content) { %><p><%= e.content %></p><% } %>
                    <div style="margin-top:0.5rem;font-size:0.85rem;">
                        <% if (sd.procedure_name) { %><strong>Procedure:</strong> <%= sd.procedure_name %><% } %>
                        <% if (sd.anaesthesia_type) { %> &bull; <strong>Anaesthesia:</strong> <%= sd.anaesthesia_type %><% } %>
                        <% if (sd.duration) { %> &bull; <strong>Duration:</strong> <%= sd.duration %> min<% } %>
                        <% if (sd.blood_loss) { %> &bull; <strong>Blood Loss:</strong> <%= sd.blood_loss %> ml<% } %>
                        <% if (sd.pre_op_diagnosis) { %><br><strong>Pre-op Dx:</strong> <%= sd.pre_op_diagnosis %><% } %>
                        <% if (sd.post_op_diagnosis) { %><br><strong>Post-op Dx:</strong> <%= sd.post_op_diagnosis %><% } %>
                        <% if (sd.findings) { %><br><strong>Findings:</strong> <%= sd.findings %><% } %>
                        <% if (sd.complications) { %><br><span style="color:var(--destructive);"><strong>Complications:</strong> <%= sd.complications %></span><% } %>
                        <% if (sd.post_op_instructions) { %><br><strong>Post-op Instructions:</strong> <%= sd.post_op_instructions %><% } %>
                    </div>

                <% } else if (e.entry_type === 'antenatal' && sd) { %>
                    <% if (e.content) { %><p><%= e.content %></p><% } %>
                    <div style="margin-top:0.5rem;font-size:0.85rem;">
                        <% if (sd.gestational_age) { %><strong>Gest. Age:</strong> <%= sd.gestational_age %> weeks<% } %>
                        <% if (sd.fundal_height) { %> &bull; <strong>Fundal Height:</strong> <%= sd.fundal_height %> cm<% } %>
                        <% if (sd.fetal_heart_rate) { %> &bull; <strong>FHR:</strong> <%= sd.fetal_heart_rate %> bpm<% } %>
                        <% if (sd.presentation) { %> &bull; <strong>Presentation:</strong> <%= sd.presentation %><% } %>
                        <% if (sd.blood_pressure) { %><br><strong>BP:</strong> <%= sd.blood_pressure %><% } %>
                        <% if (sd.weight) { %> &bull; <strong>Weight:</strong> <%= sd.weight %> kg<% } %>
                        <% if (sd.urine_protein) { %> &bull; <strong>Urine Protein:</strong> <%= sd.urine_protein %><% } %>
                        <% if (sd.urine_sugar) { %> &bull; <strong>Urine Sugar:</strong> <%= sd.urine_sugar %><% } %>
                        <% if (sd.oedema) { %> &bull; <strong>Oedema:</strong> <%= sd.oedema %><% } %>
                        <% if (sd.complaints) { %><br><strong>Complaints:</strong> <%= sd.complaints %><% } %>
                        <% if (sd.medications) { %><br><strong>Medications:</strong> <%= sd.medications %><% } %>
                        <% if (sd.next_appointment) { %><br><strong>Next Appointment:</strong> <%= sd.next_appointment %><% } %>
                    </div>

                <% } else if (e.entry_type === 'delivery' && sd) { %>
                    <% if (e.content) { %><p><%= e.content %></p><% } %>
                    <div style="margin-top:0.5rem;font-size:0.85rem;">
                        <% if (sd.delivery_type) { %><strong>Type:</strong> <%= sd.delivery_type %><% } %>
                        <% if (sd.delivery_date) { %> &bull; <strong>Date:</strong> <%= sd.delivery_date %><% } %>
                        <% if (sd.baby_weight) { %> &bull; <strong>Baby Weight:</strong> <%= sd.baby_weight %> kg<% } %>
                        <% if (sd.baby_gender) { %> &bull; <strong>Gender:</strong> <%= sd.baby_gender %><% } %>
                        <% if (sd.apgar_score) { %> &bull; <strong>APGAR:</strong> <%= sd.apgar_score %><% } %>
                        <% if (sd.blood_loss) { %><br><strong>Blood Loss:</strong> <%= sd.blood_loss %> ml<% } %>
                        <% if (sd.placenta) { %> &bull; <strong>Placenta:</strong> <%= sd.placenta %><% } %>
                        <% if (sd.perineum) { %> &bull; <strong>Perineum:</strong> <%= sd.perineum %><% } %>
                        <% if (sd.complications) { %><br><span style="color:var(--destructive);"><strong>Complications:</strong> <%= sd.complications %></span><% } %>
                        <% if (sd.baby_condition) { %><br><strong>Baby Condition:</strong> <%= sd.baby_condition %><% } %>
                    </div>

                <% } else if (e.entry_type === 'postnatal' && sd) { %>
                    <% if (e.content) { %><p><%= e.content %></p><% } %>
                    <div style="margin-top:0.5rem;font-size:0.85rem;">
                        <% if (sd.days_postpartum) { %><strong>Days Postpartum:</strong> <%= sd.days_postpartum %><% } %>
                        <% if (sd.mother_condition) { %> &bull; <strong>Mother:</strong> <%= sd.mother_condition %><% } %>
                        <% if (sd.baby_condition) { %> &bull; <strong>Baby:</strong> <%= sd.baby_condition %><% } %>
                        <% if (sd.breastfeeding) { %> &bull; <strong>Breastfeeding:</strong> <%= sd.breastfeeding %><% } %>
                        <% if (sd.baby_weight) { %><br><strong>Baby Weight:</strong> <%= sd.baby_weight %> kg<% } %>
                        <% if (sd.cord) { %> &bull; <strong>Cord:</strong> <%= sd.cord %><% } %>
                        <% if (sd.mother_vitals) { %><br><strong>Mother Vitals:</strong> <%= sd.mother_vitals %><% } %>
                        <% if (sd.immunization) { %><br><strong>Immunization:</strong> <%= sd.immunization %><% } %>
                        <% if (sd.lochia) { %> &bull; <strong>Lochia:</strong> <%= sd.lochia %><% } %>
                        <% if (sd.family_planning) { %> &bull; <strong>Family Planning:</strong> <%= sd.family_planning %><% } %>
                    </div>

                <% } else { %>
                    <p><%= e.content || 'No content' %></p>
                <% } %>
            </div>
        <% }); %>
    <% } %>
</div>
