<!-- Patients List EJS Template -->
<div class="welcome-section">
  <div class="welcome-text">
    <h1>All Patients</h1>
    <p>Manage hospital patient records</p>
  </div>
  <div class="welcome-actions">
    <button class="btn btn-primary" onclick="document.getElementById('registerPatientModal').style.display='flex'">
      <i data-lucide="user-plus"></i> Register Patient
    </button>
  </div>
</div>

<!-- Stats -->
<div class="stats-grid">
  <div class="stat-card gradient-primary">
    <i data-lucide="users" class="stat-icon"></i>
    <div class="stat-content">
      <p class="stat-label">Total Patients</p>
      <h3 class="stat-value"><%= stats.total || 0 %></h3>
    </div>
  </div>
  <div class="stat-card gradient-success">
    <i data-lucide="activity" class="stat-icon"></i>
    <div class="stat-content">
      <p class="stat-label">Active</p>
      <h3 class="stat-value"><%= stats.active || 0 %></h3>
    </div>
  </div>
  <div class="stat-card gradient-info">
    <i data-lucide="building" class="stat-icon"></i>
    <div class="stat-content">
      <p class="stat-label">Under Organization</p>
      <h3 class="stat-value"><%= stats.under_org || 0 %></h3>
    </div>
  </div>
  <div class="stat-card gradient-warning">
    <i data-lucide="shield-check" class="stat-icon"></i>
    <div class="stat-content">
      <p class="stat-label">Insured</p>
      <h3 class="stat-value"><%= stats.insured || 0 %></h3>
    </div>
  </div>
</div>

<!-- Search -->
<div class="card" style="margin-top:1.5rem;">
  <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;">
    <h2>Patient List</h2>
    <input type="text" id="patientSearchInput" placeholder="Search patients..." class="form-input" style="max-width:300px;">
  </div>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Patient</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Gender</th>
          <th>Blood Type</th>
          <th>Insurance</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="patientsTableBody">
        <% if (patients && patients.length > 0) { %>
          <% patients.forEach(function(p) { %>
            <tr>
              <td>
                <div style="display:flex;align-items:center;gap:0.5rem;">
                  <div class="avatar avatar-sm"><%= ((p.firstname || '')[0] || '') + ((p.lastname || '')[0] || '') %></div>
                  <div>
                    <p style="margin:0;font-size:0.85rem;font-weight:500;"><%= p.firstname %> <%= p.lastname %></p>
                    <p style="margin:0;font-size:0.72rem;color:var(--muted-foreground);">ID: <%= p.patient_id %></p>
                  </div>
                </div>
              </td>
              <td><%= p.email || '--' %></td>
              <td><%= p.phone || '--' %></td>
              <td><%= (p.gender || '--').replace(/\b\w/g, c => c.toUpperCase()) %></td>
              <td><%= p.blood_type || '--' %></td>
              <td><%= p.insurance_provider || 'None' %></td>
              <td>
                <button class="btn btn-sm btn-outline" onclick="viewPatientDetail(<%= p.patient_id %>)">View</button>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr><td colspan="7" style="text-align:center;padding:2rem;color:var(--muted-foreground);">No patients found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
function viewPatientDetail(id) {
  fetch('/hospital/patients/' + id, { credentials: 'include' })
    .then(r => r.text())
    .then(html => {
      document.getElementById('mainContent').innerHTML = html;
      lucide.createIcons();
    });
}

document.getElementById('patientSearchInput')?.addEventListener('input', function() {
  const q = this.value.toLowerCase();
  document.querySelectorAll('#patientsTableBody tr').forEach(row => {
    row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
  });
});
</script>