<!-- Marketplace EJS Template -->
<div class="welcome-section">
  <div class="welcome-text">
    <h1>Doctor Marketplace</h1>
    <p>Browse and request external specialist consultations</p>
  </div>
</div>

<div class="doctors-grid" style="margin-top:1.5rem;">
  <% if (doctors && doctors.length > 0) { %>
    <% doctors.forEach(function(d) { %>
      <div class="card" style="padding:1.25rem;">
        <div style="display:flex;align-items:center;gap:1rem;margin-bottom:0.75rem;">
          <div class="avatar avatar-lg" style="background:var(--gradient-primary);">
            <% if (d.profile_image) { %>
              <img src="<%= d.profile_image %>" alt="" style="width:100%;height:100%;border-radius:50%;object-fit:cover;">
            <% } else { %>
              <%= ((d.first_name || '')[0] || '') + ((d.last_name || '')[0] || '') %>
            <% } %>
          </div>
          <div style="flex:1;">
            <h3 style="margin:0;font-size:0.95rem;">Dr. <%= d.first_name %> <%= d.last_name %></h3>
            <p style="margin:0;font-size:0.8rem;color:var(--muted-foreground);"><%= d.specialty %><%= d.sub_specialty ? ' — ' + d.sub_specialty : '' %></p>
            <div style="display:flex;gap:0.5rem;margin-top:0.3rem;">
              <span class="badge badge-info"><%= d.years_experience || 0 %> yrs exp</span>
              <% if (d.rating) { %><span class="badge badge-warning">★ <%= Number(d.rating).toFixed(1) %></span><% } %>
            </div>
          </div>
        </div>
        <p style="font-size:0.8rem;color:var(--muted-foreground);margin-bottom:0.75rem;"><%= d.home_hospital_name || 'Independent' %><%= d.home_city ? ', ' + d.home_city : '' %></p>
        <div style="display:flex;gap:0.5rem;">
          <% if (d.accepts_virtual) { %><span class="badge badge-success">Virtual</span><% } %>
          <% if (d.accepts_in_person) { %><span class="badge badge-info">In-Person</span><% } %>
        </div>
        <button class="btn btn-primary btn-sm" style="margin-top:0.75rem;width:100%;" onclick="requestConsultation(<%= d.doctor_id || d.id %>)">Request Consultation</button>
      </div>
    <% }); %>
  <% } else { %>
    <div class="card" style="padding:2rem;text-align:center;color:var(--muted-foreground);grid-column:1/-1;">No doctors available on marketplace</div>
  <% } %>
</div>

<script>
function requestConsultation(doctorId) {
  alert('Consultation request form for Doctor #' + doctorId + ' — implement modal');
}
</script>