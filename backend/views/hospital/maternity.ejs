<!-- Maternity EJS Template -->
<div class="welcome-section">
  <div class="welcome-text">
    <h1>Maternity Ward</h1>
    <p>Antenatal, delivery, and postnatal care management</p>
  </div>
  <div class="welcome-actions">
    <button class="btn btn-primary" onclick="document.getElementById('addMaternityModal').style.display='flex'">
      <i data-lucide="plus"></i> Register ANC
    </button>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card gradient-primary">
    <i data-lucide="users" class="stat-icon"></i>
    <div class="stat-content">
      <p class="stat-label">Total Records</p>
      <h3 class="stat-value"><%= stats.total || 0 %></h3>
    </div>
  </div>
  <div class="stat-card gradient-info">
    <i data-lucide="baby" class="stat-icon"></i>
    <div class="stat-content">
      <p class="stat-label">Active ANC</p>
      <h3 class="stat-value"><%= stats.active_anc || 0 %></h3>
    </div>
  </div>
  <div class="stat-card gradient-success">
    <i data-lucide="heart" class="stat-icon"></i>
    <div class="stat-content">
      <p class="stat-label">Delivered</p>
      <h3 class="stat-value"><%= stats.delivered_this_month || 0 %></h3>
    </div>
  </div>
  <div class="stat-card gradient-danger">
    <i data-lucide="alert-triangle" class="stat-icon"></i>
    <div class="stat-content">
      <p class="stat-label">High Risk</p>
      <h3 class="stat-value"><%= stats.high_risk || 0 %></h3>
    </div>
  </div>
</div>

<div class="card" style="margin-top:1.5rem;">
  <div class="card-header"><h2>Maternity Records</h2></div>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr><th>Patient</th><th>Doctor</th><th>EDD</th><th>Gestational Age</th><th>Risk Level</th><th>Status</th></tr>
      </thead>
      <tbody>
        <% if (records && records.length > 0) { %>
          <% records.forEach(function(m) { %>
            <tr>
              <td><%= m.patient_name || '--' %></td>
              <td>Dr. <%= m.doctor_name || '--' %></td>
              <td><%= m.edd ? new Date(m.edd).toLocaleDateString('en-NG') : '--' %></td>
              <td><%= m.gestational_age_weeks || '--' %> weeks</td>
              <td><span class="badge badge-<%= m.risk_level === 'high' ? 'danger' : m.risk_level === 'medium' ? 'warning' : 'success' %>"><%= (m.risk_level || 'low').replace(/\b\w/g, c => c.toUpperCase()) %></span></td>
              <td><span class="status-badge <%= m.status %>"><%= (m.status || '').replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) %></span></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr><td colspan="6" style="text-align:center;padding:2rem;color:var(--muted-foreground);">No maternity records</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>