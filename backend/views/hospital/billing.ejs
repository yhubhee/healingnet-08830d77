<!-- Billing EJS Template -->
<div class="welcome-section">
  <div class="welcome-text">
    <h1>Billing & Revenue</h1>
    <p>Manage hospital billing and track payments</p>
  </div>
  <div class="welcome-actions">
    <button class="btn btn-primary" onclick="document.getElementById('createBillModal').style.display='flex'">
      <i data-lucide="plus"></i> Create Bill
    </button>
  </div>
</div>

<!-- Stats -->
<div class="stats-grid">
  <div class="stat-card gradient-primary">
    <i data-lucide="receipt" class="stat-icon"></i>
    <div class="stat-content">
      <p class="stat-label">Total Billed</p>
      <h3 class="stat-value"><%= formatNaira(totals.total_billed) %></h3>
    </div>
  </div>
  <div class="stat-card gradient-success">
    <i data-lucide="check-circle" class="stat-icon"></i>
    <div class="stat-content">
      <p class="stat-label">Collected</p>
      <h3 class="stat-value"><%= formatNaira(totals.total_paid) %></h3>
    </div>
  </div>
  <div class="stat-card gradient-warning">
    <i data-lucide="clock" class="stat-icon"></i>
    <div class="stat-content">
      <p class="stat-label">Pending</p>
      <h3 class="stat-value"><%= formatNaira(totals.total_pending) %></h3>
    </div>
  </div>
  <div class="stat-card gradient-info">
    <i data-lucide="hash" class="stat-icon"></i>
    <div class="stat-content">
      <p class="stat-label">Total Bills</p>
      <h3 class="stat-value"><%= totals.total_count || 0 %></h3>
    </div>
  </div>
</div>

<!-- Bills Table -->
<div class="card" style="margin-top:1.5rem;">
  <div class="card-header"><h2>Recent Bills</h2></div>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Patient</th>
          <th>Type</th>
          <th>Description</th>
          <th>Amount</th>
          <th>Status</th>
          <th>Date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (bills && bills.length > 0) { %>
          <% bills.forEach(function(b) { %>
            <tr>
              <td>#<%= b.id %></td>
              <td><%= b.patient_first_name || b.firstname || '' %> <%= b.patient_last_name || b.lastname || '' %></td>
              <td><span class="badge"><%= (b.billing_type || '').replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) %></span></td>
              <td><%= b.description || '--' %></td>
              <td style="font-weight:600;"><%= formatNaira(b.total) %></td>
              <td><span class="status-badge <%= b.payment_status %>"><%= (b.payment_status || '').replace(/\b\w/g, c => c.toUpperCase()) %></span></td>
              <td><%= b.created_at ? new Date(b.created_at).toLocaleDateString('en-NG') : '--' %></td>
              <td>
                <% if (b.payment_status === 'pending') { %>
                  <button class="btn btn-sm btn-success" onclick="markBillPaid(<%= b.id %>)">Mark Paid</button>
                <% } else { %>
                  <span style="color:var(--muted-foreground);font-size:0.8rem;">Paid</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr><td colspan="8" style="text-align:center;padding:2rem;color:var(--muted-foreground);">No bills found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
function markBillPaid(id) {
  fetch('/hospital/billing/' + id + '/pay', {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    credentials: 'include',
    body: JSON.stringify({ payment_method: 'cash' })
  }).then(r => r.json()).then(json => {
    if (json.success) {
      document.querySelector('[data-url="/hospital/billing"]')?.click();
    }
  });
}
</script>